PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/agent-marketplace
# Generate with: pnpm run encryption:keygen
DB_ENCRYPTION_ACTIVE_KEY_ID=your_db_encryption_active_key_id_here
DB_ENCRYPTION_KEYS={"key_20260327T033000Z":"base64:replace-with-generated-value"}

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=Agent Marketplace <noreply@yourdomain.com>

# App
WEBSITE_URL=https://agentmarketplace.vercel.app/
# Public base URL of this backend, used to build OAuth redirect_uri values for MCP connectors
BACKEND_URL=http://localhost:3000

# AI / LangChain
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agent-marketplace-backend

# Knowledge Base & Vector Store
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=5
