PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/agent-marketplace
# Generate with: pnpm run encryption:keygen
DB_ENCRYPTION_ACTIVE_KEY_ID=your_db_encryption_active_key_id_here
DB_ENCRYPTION_KEYS={"key_20260327T033000Z":"base64:replace-with-generated-value"}

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Developer Platform — Project credential secret hashing (AD-01 §9.3). A
# server-side pepper for HMAC-SHA256 hashing of Project credential secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROJECT_CREDENTIAL_HASH_SECRET=your_project_credential_hash_secret_here

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=Agent Marketplace <noreply@yourdomain.com>

# App
WEBSITE_URL=https://agentmarketplace.vercel.app/
# Developer Platform (Studio) app URL — separate deployment from WEBSITE_URL,
# used to land Project Admin flows (e.g. MCP owner-connect OAuth) back on
# the right app
PLATFORM_URL=https://platform.persona.hasanraiyan.me/
# Public base URL of this backend, used to build OAuth redirect_uri values for MCP connectors
BACKEND_URL=https://api.persona.hasanraiyan.me

# AI / LangChain
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agent-marketplace-backend

# Web Search (Tavily) — platform-wide fallback for agents with
# webSearchEnabled. A Project can override this with its own
# TAVILY_API_KEY ProjectSecret; Persona (non-Project) agents always use
# this env var.
TAVILY_API_KEY=your_tavily_api_key_here

# Knowledge Base & Vector Store
# Local dev (Docker): docker run -d --name persona-qdrant -p 6333:6333 -p 6334:6334 \
#   -v persona_qdrant_storage:/qdrant/storage qdrant/qdrant
# ...then QDRANT_URL=http://localhost:6333 and leave QDRANT_API_KEY empty.
# QDRANT_API_KEY is only needed for Qdrant Cloud / secured clusters.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
# Default embedding model for NEW knowledge bases. Each knowledge base stores
# the model + resolved dimensions it was created with, so changing this never
# affects existing knowledge bases. OpenAI-compatible providers (OpenAI,
# DeepSeek, Ollama, custom) are supported; e.g. embeddinggemma-2 (768 dims).
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=5
