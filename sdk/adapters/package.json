{
  "name": "@personaai/adapters",
  "version": "0.2.0",
  "description": "Unified Persona adapters — Express, Next.js, NestJS in one package with shared internals. Server-side only.",
  "type": "module",
  "exports": {
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js",
      "require": "./dist/express/index.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs/client.d.ts",
      "import": "./dist/nextjs/client.js",
      "require": "./dist/nextjs/client.cjs"
    },
    "./nextjs/server": {
      "types": "./dist/nextjs/server.d.ts",
      "import": "./dist/nextjs/server.js",
      "require": "./dist/nextjs/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "node -e \"const p=require('./package.json');const d=p.dependencies||{};for(const k of Object.keys(d)){if(String(d[k]).startsWith('file:')){console.error('Refusing to publish: '+k+' must be a registry version, not a file: link.');process.exit(1)}}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "persona",
    "persona.hasanraiyan.me",
    "express",
    "nextjs",
    "nestjs",
    "adapter",
    "runtime",
    "ag-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hasanraiyan/agent-marketplace/tree/main/sdk/adapters#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/agent-marketplace.git",
    "directory": "sdk/adapters"
  },
  "bugs": {
    "url": "https://github.com/hasanraiyan/agent-marketplace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "express": ">=4",
    "next": ">=14",
    "react": ">=18.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "reflect-metadata": { "optional": true },
    "rxjs": { "optional": true }
  },
  "dependencies": {
    "@personaai/logger": "^0.1.0",
    "@personaai/react": "^0.9.0",
    "@personaai/runtime": "^0.10.0",
    "@personaai/sdk": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.19.0",
    "express": "^5.2.1",
    "supertest": "^7.0.0",
    "next": "^15.1.6",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
