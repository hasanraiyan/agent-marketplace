{
  "name": "@personaai/logger",
  "version": "0.1.0",
  "description": "Isomorphic, zero-dependency logger for the Persona SDK ecosystem — OFF by default, selectable levels, child namespaces, browser+Node safe.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "persona",
    "persona.hasanraiyan.me",
    "logger",
    "logging"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hasanraiyan/agent-marketplace/tree/feat/ai/sdk/logger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/agent-marketplace.git",
    "directory": "sdk/logger"
  },
  "bugs": {
    "url": "https://github.com/hasanraiyan/agent-marketplace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
