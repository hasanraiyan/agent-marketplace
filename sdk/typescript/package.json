{
  "name": "@personaai/sdk",
  "version": "0.7.0",
  "description": "Node.js/TypeScript SDK for the persona.hasanraiyan.me Developer Platform API. Server-side only — never bundle into a browser app.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rest-tools": {
      "types": "./dist/rest-tools.d.ts",
      "import": "./dist/rest-tools.js",
      "require": "./dist/rest-tools.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "docs:check": "node scripts/check-docs-coverage.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "persona",
    "persona.hasanraiyan.me",
    "sdk",
    "ag-ui",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hasanraiyan/agent-marketplace/tree/feat/ai/sdk/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanraiyan/agent-marketplace.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/hasanraiyan/agent-marketplace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.57",
    "@personaai/logger": "^0.1.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
